  175 0000000E         ; Macro to define default exception/interrupt handlers.
  176 0000000E         ; Default handler are weak symbols with an endless loop.
                       
  177 0000000E         ; They can be overwritten by real handlers.
  178 0000000E                 MACRO
  179 0000000E                 Set_Default_Handler
                                                $Handler_Name
  180 0000000E         $Handler_Name
                               PROC
  181 0000000E                 EXPORT           $Handler_Name             [WEAK
]
  182 0000000E                 B                .
  183 0000000E                 ENDP
  184 0000000E                 MEND



